PORT=4000
CORS_ORIGIN=http://localhost:5173
DB_PATH=./data/agent.db
WORKSPACE_ROOT=../workspace

# better-auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM config — set LLM_MODE to "openrouter", "ollama", or "stub"
LLM_MODE=stub

# OpenRouter (LLM_MODE=openrouter)
LLM_API_KEY=your_openrouter_api_key_here
LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=meta-llama/llama-3.1-70b-instruct
SITE_URL=http://localhost:5173
SITE_NAME=autocoder

# Ollama (LLM_MODE=ollama)
# OLLAMA_HOST=localhost:11434   # default; change if Ollama runs elsewhere
# LLM_MODEL=llama3.2            # any model you've pulled with `ollama pull`
